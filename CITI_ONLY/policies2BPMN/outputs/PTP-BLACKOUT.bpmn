<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:policy="http://policies2bpmn.local/policy" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_PTP-BLACKOUT" targetNamespace="http://policies2bpmn.local/workflows" xsi:schemaLocation="">
  <collaboration id="Collab_PTP-BLACKOUT">
    <participant id="Participant_PTP-BLACKOUT" name="Global Personal Trading Policy" processRef="Process_PTP-BLACKOUT"/>
  </collaboration>
  <process id="Process_PTP-BLACKOUT" name="Observe Blackout Periods" isExecutable="false">
    <laneSet id="LaneSet_PTP-BLACKOUT">
      <lane id="Lane_ACT-EMPLOYEE" name="Employee">
        <flowNodeRef>START-001</flowNodeRef>
        <flowNodeRef>STEP-001</flowNodeRef>
        <flowNodeRef>STEP-002</flowNodeRef>
        <flowNodeRef>STEP-003</flowNodeRef>
        <flowNodeRef>END-PROHIBITED</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="START-001" name="Policy rule in section 10 applies.">
      <extensionElements>
        <policy:sourceReference sectionId="10" referenceId="REF-001" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </startEvent>
    <userTask id="STEP-001" name="Not trade in a security or futures contract at a time when you k">
      <extensionElements>
        <policy:sourceReference sectionId="10" referenceId="REF-001" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-002" name="Not trade in a security or futures contract within 7 calen dar d">
      <extensionElements>
        <policy:sourceReference sectionId="10" referenceId="REF-002" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-003" name="Pre-approval is obtained by Legal &amp; Compliance in consultation…">
      <extensionElements>
        <policy:sourceReference sectionId="10" referenceId="REF-003" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <endEvent id="END-PROHIBITED" name="Must not proceed — prohibited by policy"/>
    <sequenceFlow id="Flow_001" sourceRef="START-001" targetRef="STEP-001"/>
    <sequenceFlow id="Flow_002" sourceRef="STEP-001" targetRef="STEP-002"/>
    <sequenceFlow id="Flow_003" sourceRef="STEP-002" targetRef="STEP-003"/>
    <sequenceFlow id="Flow_004" sourceRef="STEP-003" targetRef="END-PROHIBITED"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PTP-BLACKOUT">
    <bpmndi:BPMNPlane id="Plane_PTP-BLACKOUT" bpmnElement="Process_PTP-BLACKOUT">
      <bpmndi:BPMNShape id="Shape_START-001" bpmnElement="START-001">
        <dc:Bounds x="117.0" y="92.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-001" bpmnElement="STEP-001" bioc:stroke="#C45E12" bioc:fill="#FCE8D5">
        <dc:Bounds x="270.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-002" bpmnElement="STEP-002" bioc:stroke="#C45E12" bioc:fill="#FCE8D5">
        <dc:Bounds x="470.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-003" bpmnElement="STEP-003" bioc:stroke="#C45E12" bioc:fill="#FCE8D5">
        <dc:Bounds x="670.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_END-PROHIBITED" bpmnElement="END-PROHIBITED" bioc:stroke="#C45E12" bioc:fill="#FCE8D5">
        <dc:Bounds x="917.0" y="92.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_001" bpmnElement="Flow_001">
        <di:waypoint x="153.0" y="110.0"/>
        <di:waypoint x="270.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_002" bpmnElement="Flow_002" bioc:stroke="#C45E12">
        <di:waypoint x="400.0" y="110.0"/>
        <di:waypoint x="470.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_003" bpmnElement="Flow_003" bioc:stroke="#C45E12">
        <di:waypoint x="600.0" y="110.0"/>
        <di:waypoint x="670.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_004" bpmnElement="Flow_004" bioc:stroke="#C45E12">
        <di:waypoint x="800.0" y="110.0"/>
        <di:waypoint x="917.0" y="110.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
