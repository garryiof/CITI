# Copy to .env and fill in. Never commit .env.
# PowerShell:  Copy-Item .env.example .env

# CITI Hub (default): Llama 4 via GuardRail — no OpenAI key
POLICY_LLM_PROVIDER=llama4
POLICY_LLM_MODEL=Llama-4-Scout
# POLICY_LLM_NARRATIVE_MODEL=Llama-4-Scout
# SOEID=your_soeid

# Home-only OpenAI path (optional):
# POLICY_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here
# POLICY_LLM_MODEL=gpt-4o-mini

# POLICY_WORKSPACE_ID=POLICY_001
# POLICY_PATH=
