<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:policy="http://policies2bpmn.local/policy" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_PTP-BROKER" targetNamespace="http://policies2bpmn.local/workflows" xsi:schemaLocation="">
  <collaboration id="Collab_PTP-BROKER">
    <participant id="Participant_PTP-BROKER" name="Global Personal Trading Policy" processRef="Process_PTP-BROKER"/>
  </collaboration>
  <process id="Process_PTP-BROKER" name="Maintain Accounts with Approved Brokers" isExecutable="false">
    <laneSet id="LaneSet_PTP-BROKER">
      <lane id="Lane_ACT-EMPLOYEE" name="Employee">
        <flowNodeRef>START-001</flowNodeRef>
        <flowNodeRef>STEP-001</flowNodeRef>
        <flowNodeRef>STEP-002</flowNodeRef>
        <flowNodeRef>STEP-005</flowNodeRef>
        <flowNodeRef>STEP-006</flowNodeRef>
        <flowNodeRef>STEP-007</flowNodeRef>
        <flowNodeRef>STEP-008</flowNodeRef>
        <flowNodeRef>END-001</flowNodeRef>
      </lane>
      <lane id="Lane_ACT-COMPLIANCE" name="Compliance">
        <flowNodeRef>STEP-003</flowNodeRef>
      </lane>
      <lane id="Lane_ACT-SYSTEM" name="PTA System">
        <flowNodeRef>STEP-004</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="START-001" name="Employee initiates activity under section 4.">
      <extensionElements>
        <policy:sourceReference sectionId="4" referenceId="REF-001" confidence="0.85" extractionType="EXPLICIT"/>
      </extensionElements>
    </startEvent>
    <userTask id="STEP-001" name="Identify intended activity">
      <extensionElements>
        <policy:sourceReference sectionId="4" referenceId="REF-001" confidence="0.75" extractionType="INFERRED"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-002" name="Approved Broker List (an “Approved Broker”)">
      <extensionElements>
        <policy:sourceReference sectionId="4" referenceId="REF-001" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-003" name="Maintain account(s) with a Non Approved Broker must be approved…">
      <extensionElements>
        <policy:sourceReference sectionId="4" referenceId="REF-002" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <serviceTask id="STEP-004" name="Disclose required information">
      <extensionElements>
        <policy:sourceReference sectionId="4" referenceId="REF-003" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </serviceTask>
    <userTask id="STEP-005" name="Submit reportable transactions and holdings information to…">
      <extensionElements>
        <policy:sourceReference sectionId="4" referenceId="REF-004" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-006" name="Submit required information">
      <extensionElements>
        <policy:sourceReference sectionId="4" referenceId="REF-005" confidence="0.84" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-007" name="Submit required information">
      <extensionElements>
        <policy:sourceReference sectionId="4" referenceId="REF-006" confidence="0.84" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-008" name="Disclose the account information and the name of the transfer…">
      <extensionElements>
        <policy:sourceReference sectionId="4" referenceId="REF-007" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <endEvent id="END-001" name="Process completed"/>
    <sequenceFlow id="Flow_001" sourceRef="START-001" targetRef="STEP-001"/>
    <sequenceFlow id="Flow_002" sourceRef="STEP-001" targetRef="STEP-002"/>
    <sequenceFlow id="Flow_003" sourceRef="STEP-002" targetRef="STEP-003"/>
    <sequenceFlow id="Flow_004" sourceRef="STEP-003" targetRef="STEP-004"/>
    <sequenceFlow id="Flow_005" sourceRef="STEP-004" targetRef="STEP-005"/>
    <sequenceFlow id="Flow_006" sourceRef="STEP-005" targetRef="STEP-006"/>
    <sequenceFlow id="Flow_007" sourceRef="STEP-006" targetRef="STEP-007"/>
    <sequenceFlow id="Flow_008" sourceRef="STEP-007" targetRef="STEP-008"/>
    <sequenceFlow id="Flow_009" sourceRef="STEP-008" targetRef="END-001"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PTP-BROKER">
    <bpmndi:BPMNPlane id="Plane_PTP-BROKER" bpmnElement="Process_PTP-BROKER">
      <bpmndi:BPMNShape id="Shape_START-001" bpmnElement="START-001">
        <dc:Bounds x="117.0" y="92.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-001" bpmnElement="STEP-001">
        <dc:Bounds x="270.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-002" bpmnElement="STEP-002">
        <dc:Bounds x="470.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-003" bpmnElement="STEP-003">
        <dc:Bounds x="670.0" y="240.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-004" bpmnElement="STEP-004">
        <dc:Bounds x="870.0" y="410.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-005" bpmnElement="STEP-005">
        <dc:Bounds x="1070.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-006" bpmnElement="STEP-006">
        <dc:Bounds x="1270.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-007" bpmnElement="STEP-007">
        <dc:Bounds x="1470.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-008" bpmnElement="STEP-008">
        <dc:Bounds x="1670.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_END-001" bpmnElement="END-001">
        <dc:Bounds x="1917.0" y="92.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_001" bpmnElement="Flow_001">
        <di:waypoint x="153.0" y="110.0"/>
        <di:waypoint x="270.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_002" bpmnElement="Flow_002">
        <di:waypoint x="400.0" y="110.0"/>
        <di:waypoint x="470.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_003" bpmnElement="Flow_003">
        <di:waypoint x="600.0" y="110.0"/>
        <di:waypoint x="635.0" y="110.0"/>
        <di:waypoint x="635.0" y="280.0"/>
        <di:waypoint x="670.0" y="280.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_004" bpmnElement="Flow_004">
        <di:waypoint x="800.0" y="280.0"/>
        <di:waypoint x="835.0" y="280.0"/>
        <di:waypoint x="835.0" y="450.0"/>
        <di:waypoint x="870.0" y="450.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_005" bpmnElement="Flow_005">
        <di:waypoint x="1000.0" y="450.0"/>
        <di:waypoint x="1035.0" y="450.0"/>
        <di:waypoint x="1035.0" y="110.0"/>
        <di:waypoint x="1070.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_006" bpmnElement="Flow_006">
        <di:waypoint x="1200.0" y="110.0"/>
        <di:waypoint x="1270.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_007" bpmnElement="Flow_007">
        <di:waypoint x="1400.0" y="110.0"/>
        <di:waypoint x="1470.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_008" bpmnElement="Flow_008">
        <di:waypoint x="1600.0" y="110.0"/>
        <di:waypoint x="1670.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_009" bpmnElement="Flow_009">
        <di:waypoint x="1800.0" y="110.0"/>
        <di:waypoint x="1917.0" y="110.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
