<?xml version='1.0' encoding='UTF-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:policy="http://policies2bpmn.local/policy" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Defs_PTP-DISC" targetNamespace="http://policies2bpmn.local/workflows" xsi:schemaLocation="">
  <collaboration id="Collab_PTP-DISC">
    <participant id="Participant_PTP-DISC" name="Global Personal Trading Policy" processRef="Process_PTP-DISC"/>
  </collaboration>
  <process id="Process_PTP-DISC" name="Disclose Reportable Accounts" isExecutable="false">
    <laneSet id="LaneSet_PTP-DISC">
      <lane id="Lane_ACT-EMPLOYEE" name="Employee">
        <flowNodeRef>START-001</flowNodeRef>
        <flowNodeRef>STEP-001</flowNodeRef>
        <flowNodeRef>STEP-002</flowNodeRef>
        <flowNodeRef>STEP-003</flowNodeRef>
        <flowNodeRef>STEP-004</flowNodeRef>
        <flowNodeRef>STEP-005</flowNodeRef>
        <flowNodeRef>STEP-006</flowNodeRef>
        <flowNodeRef>GATEWAY-001</flowNodeRef>
        <flowNodeRef>END-REJECTED</flowNodeRef>
        <flowNodeRef>END-001</flowNodeRef>
      </lane>
      <lane id="Lane_ACT-COMPLIANCE" name="Compliance">
        <flowNodeRef>STEP-007</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="START-001" name="Employee initiates activity under section 3.">
      <extensionElements>
        <policy:sourceReference sectionId="3" referenceId="REF-001" confidence="0.84" extractionType="EXPLICIT"/>
      </extensionElements>
    </startEvent>
    <userTask id="STEP-001" name="Identify intended activity">
      <extensionElements>
        <policy:sourceReference sectionId="3" referenceId="REF-001" confidence="0.75" extractionType="INFERRED"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-002" name="Disclose brokerage or other investment accounts">
      <extensionElements>
        <policy:sourceReference sectionId="3" referenceId="REF-001" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-007" name="Review pre-clearance request">
      <extensionElements>
        <policy:sourceReference sectionId="3" referenceId="REF-002" confidence="0.8" extractionType="INFERRED"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-003" name="Submit required information">
      <extensionElements>
        <policy:sourceReference sectionId="3" referenceId="REF-002" confidence="0.84" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-004" name="Certification : Within ten days of joining BlackRock">
      <extensionElements>
        <policy:sourceReference sectionId="3" referenceId="REF-003" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-005" name="Report in PTA">
      <extensionElements>
        <policy:sourceReference sectionId="3" referenceId="REF-004" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <userTask id="STEP-006" name="Perform required action">
      <extensionElements>
        <policy:sourceReference sectionId="3" referenceId="REF-005" confidence="0.87" extractionType="EXPLICIT"/>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="GATEWAY-001" name="Was the request approved?"/>
    <endEvent id="END-REJECTED" name="Activity must not proceed"/>
    <endEvent id="END-001" name="Process completed"/>
    <sequenceFlow id="Flow_001" sourceRef="START-001" targetRef="STEP-001"/>
    <sequenceFlow id="Flow_002" sourceRef="STEP-001" targetRef="STEP-002"/>
    <sequenceFlow id="Flow_003" sourceRef="STEP-002" targetRef="STEP-007"/>
    <sequenceFlow id="Flow_004" sourceRef="STEP-007" targetRef="STEP-003"/>
    <sequenceFlow id="Flow_005" sourceRef="STEP-003" targetRef="GATEWAY-001"/>
    <sequenceFlow id="Flow_006" sourceRef="STEP-004" targetRef="STEP-005"/>
    <sequenceFlow id="Flow_007" sourceRef="STEP-005" targetRef="STEP-006"/>
    <sequenceFlow id="Flow_008" sourceRef="STEP-006" targetRef="END-001"/>
    <sequenceFlow id="Flow_009" sourceRef="GATEWAY-001" targetRef="STEP-004" name="Approved"/>
    <sequenceFlow id="Flow_010" sourceRef="GATEWAY-001" targetRef="END-REJECTED" name="Rejected"/>
  </process>
  <bpmndi:BPMNDiagram id="Diagram_PTP-DISC">
    <bpmndi:BPMNPlane id="Plane_PTP-DISC" bpmnElement="Process_PTP-DISC">
      <bpmndi:BPMNShape id="Shape_START-001" bpmnElement="START-001">
        <dc:Bounds x="117.0" y="92.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-001" bpmnElement="STEP-001">
        <dc:Bounds x="270.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-002" bpmnElement="STEP-002">
        <dc:Bounds x="470.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-007" bpmnElement="STEP-007">
        <dc:Bounds x="670.0" y="240.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-003" bpmnElement="STEP-003">
        <dc:Bounds x="870.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-004" bpmnElement="STEP-004" bioc:stroke="#2F7D4F" bioc:fill="#E4F2E9">
        <dc:Bounds x="1270.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-005" bpmnElement="STEP-005" bioc:stroke="#2F7D4F" bioc:fill="#E4F2E9">
        <dc:Bounds x="1470.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_STEP-006" bpmnElement="STEP-006" bioc:stroke="#2F7D4F" bioc:fill="#E4F2E9">
        <dc:Bounds x="1670.0" y="70.0" width="130.0" height="80.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_GATEWAY-001" bpmnElement="GATEWAY-001">
        <dc:Bounds x="1110.0" y="85.0" width="50.0" height="50.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_END-REJECTED" bpmnElement="END-REJECTED" bioc:stroke="#B3402E" bioc:fill="#F8E3DD">
        <dc:Bounds x="1317.0" y="197.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_END-001" bpmnElement="END-001" bioc:stroke="#2F7D4F" bioc:fill="#E4F2E9">
        <dc:Bounds x="1917.0" y="92.0" width="36.0" height="36.0"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_001" bpmnElement="Flow_001">
        <di:waypoint x="153.0" y="110.0"/>
        <di:waypoint x="270.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_002" bpmnElement="Flow_002">
        <di:waypoint x="400.0" y="110.0"/>
        <di:waypoint x="470.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_003" bpmnElement="Flow_003">
        <di:waypoint x="600.0" y="110.0"/>
        <di:waypoint x="635.0" y="110.0"/>
        <di:waypoint x="635.0" y="280.0"/>
        <di:waypoint x="670.0" y="280.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_004" bpmnElement="Flow_004">
        <di:waypoint x="800.0" y="280.0"/>
        <di:waypoint x="835.0" y="280.0"/>
        <di:waypoint x="835.0" y="110.0"/>
        <di:waypoint x="870.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_005" bpmnElement="Flow_005">
        <di:waypoint x="1000.0" y="110.0"/>
        <di:waypoint x="1110.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_006" bpmnElement="Flow_006" bioc:stroke="#2F7D4F">
        <di:waypoint x="1400.0" y="110.0"/>
        <di:waypoint x="1470.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_007" bpmnElement="Flow_007" bioc:stroke="#2F7D4F">
        <di:waypoint x="1600.0" y="110.0"/>
        <di:waypoint x="1670.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_008" bpmnElement="Flow_008" bioc:stroke="#2F7D4F">
        <di:waypoint x="1800.0" y="110.0"/>
        <di:waypoint x="1917.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_009" bpmnElement="Flow_009" bioc:stroke="#2F7D4F">
        <di:waypoint x="1160.0" y="110.0"/>
        <di:waypoint x="1270.0" y="110.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_010" bpmnElement="Flow_010" bioc:stroke="#B3402E">
        <di:waypoint x="1160.0" y="110.0"/>
        <di:waypoint x="1238.5" y="110.0"/>
        <di:waypoint x="1238.5" y="215.0"/>
        <di:waypoint x="1317.0" y="215.0"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
